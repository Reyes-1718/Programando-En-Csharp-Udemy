<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Las PackageVersion también fijan las dependencias transitivas (p. ej. System.Security.Cryptography.Pkcs). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pruebas -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />

    <!-- Microsoft Extensions -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.0" />

    <!-- API -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="9.0.6" />

    <!-- JSON -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />

    <!-- Roslyn (generador de código, netstandard2.0) -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.3" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.2.0" />

    <!-- Base de datos (ADO.NET) -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <!-- Dependencia transitiva de Microsoft.Data.SqlClient, fijada a una versión sin vulnerabilidades conocidas. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>
</Project>
